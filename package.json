{
  "name": "intrale-platform-pipeline",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "validate:agent-models": "node .pipeline/lib/agent-models-validate.js",
    "test:pipeline": "node scripts/test-pipeline.js",
    "test:pipeline:tracked": "node scripts/test-pipeline.js --tracked-only",
    "test:hooks": "node --test --test-timeout=30000 \".claude/hooks/tests/test-*.js\"",
    "smoke:commander": "node .pipeline/tests/smoke/commander-degraded.smoke.js",
    "pruebas:env": "node .pipeline/scripts/provision-test-env.js",
    "pruebas:env:destroy": "node .pipeline/scripts/provision-test-env.js --destroy",
    "pruebas:env:verify": "node .pipeline/scripts/provision-test-env.js --verify"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1101.0",
    "@aws-sdk/credential-provider-ini": "3.973.11",
    "ajv": "^8.20.0",
    "canvas": "^3.2.1",
    "js-yaml": "^4.1.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
