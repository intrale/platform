#!/usr/bin/env sh
# =============================================================================
# .husky/pre-commit — Validación de agent-models.json (#3081 CA-5)
#
# Comportamiento defensivo:
#   - Happy path (validación OK): silencioso o una sola línea "[validate] OK".
#   - Path con error: 4-line error UX format + exit code != 0 (rechaza commit).
#   - Toolchain ausente (node_modules sin ajv): warning + exit 0 (no bloquea
#     commits legítimos en clones frescos sin npm install).
#
# Re-usa exactamente el mismo módulo que el boot del pulpo (DRY).
# =============================================================================

# Decidir cuándo validar:
#   - Si se stage agent-models.json → validar SIEMPRE (es lo que estamos commiteando).
#   - Si se stage solo el schema o el validador → validar solo si agent-models.json
#     YA existe en disco. Esto evita la chicken-and-egg cuando #3072 todavía
#     no mergeó (caso CA-2: archivo ausente con mensaje accionable).
#   - Caso contrario → no validar (evita ruido en commits que no tocan el área).
TOUCHED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

# Guard compartido local/CI (#6111). Debe ejecutarse antes de cualquier
# early-exit de RUN_VALIDATE y exactamente una vez.
if [ -f ".pipeline/lib/precommit-secret-scan.js" ]; then
  node .pipeline/lib/precommit-secret-scan.js --staged || exit $?
fi

# =============================================================================
# Issue #5175 CA-4b — Guardrail del envoltorio de estado operativo
# (`.pipeline/lib/operational-state.js`), capa local del doble wiring.
#
# POR QUE ESTE BLOQUE ESTA ACA ARRIBA Y NO ABAJO CON EL DE ghost-artifact-lint:
# el `exit 0` de la validacion de agent-models (unas lineas mas abajo) corta el
# hook entero cuando no se stagea `agent-models.json`. Verificado con `sh -x`:
# en un commit que toca `.pipeline/**/*.js` el hook sale en ese `exit 0` y NUNCA
# llega al final del archivo. Un bloque puesto abajo seria codigo muerto, y
# "doble wiring" con una capa que no corre es wiring simple (CA-4a).
#
# NO mover este bloque hacia abajo "para agrupar con los otros lints" sin antes
# arreglar ese early-exit. El secret-scan ya quedó por encima en #6111; el
# ghost-artifact-lint sigue fuera del alcance de este cambio.
#
# ATENCION: corre en `--report-only` y NO propaga el exit code. Esto CONTRADICE
# el patron del bloque de ghost-artifact-lint A PROPOSITO (R5 del issue):
#
#   - Al momento del merge de la parte 1 el repo tiene 18 violations reales: la
#     migracion de lectores va en la parte 2 y la de escritores en la parte 3
#     (#5109). Con `--check` aca, TODO commit que toque `.pipeline/` falla desde
#     el merge, con el CI en verde — o sea, invisible.
#   - El remedio obvio frente a eso es `--no-verify`, y eso mata la capa local
#     del doble wiring de forma permanente. El costo de un falso bloqueo no es
#     un commit molesto: es perder el hook para siempre.
#   - El flip a `--check` va en la parte 3, con las violations en cero.
#
# Se filtra a los archivos staged (`--only`): sin filtro escupe avisos de
# archivos que el dev no toco en cada commit que roce `.pipeline/`, y eso
# entrena a ignorar el hook (UX-1).
# =============================================================================
if [ -f ".pipeline/lib/operational-state-lint.js" ]; then
  OPSTATE_ONLY=$(printf '%s\n' "$TOUCHED_FILES" | grep '^\.pipeline/.*\.js$' | paste -sd, - 2>/dev/null || true)
  if [ -n "$OPSTATE_ONLY" ]; then
    node .pipeline/lib/operational-state-lint.js --report-only --only="$OPSTATE_ONLY" || true
  fi
fi

RUN_VALIDATE=0
case "$TOUCHED_FILES" in
  *".pipeline/agent-models.json"*) RUN_VALIDATE=1 ;;
esac

if [ "$RUN_VALIDATE" = "0" ]; then
  case "$TOUCHED_FILES" in
    *".pipeline/agent-models.schema.json"*|*".pipeline/lib/agent-models-validate.js"*)
      if [ -f ".pipeline/agent-models.json" ]; then
        RUN_VALIDATE=1
      fi
      ;;
  esac
fi

if [ "$RUN_VALIDATE" = "0" ]; then
  exit 0
fi

# Bootstrapping defensivo: si node_modules/ajv no existe, NO bloquear el commit.
# Esto cubre clones frescos y ramas que aún no corrieron `npm install`.
# El operador queda avisado para correr npm install cuando pueda.
if [ ! -d "node_modules/ajv" ]; then
  printf '[warn] agent-models validate skip: falta "ajv" (correr "npm install" para activar)\n' >&2
  exit 0
fi

# Validación real — el módulo se encarga del formato de error y exit code.
node .pipeline/lib/agent-models-validate.js --quiet
EXIT=$?

# Exit code 3 = toolchain ausente runtime → trasladar a warning + exit 0.
# Exit code 2 = config inválida → propagar (rechaza commit).
# Exit code 0 = OK → propagar.
if [ "$EXIT" = "3" ]; then
  printf '[warn] agent-models validate skip: toolchain incompleto (correr "npm install")\n' >&2
elif [ "$EXIT" != "0" ]; then
  exit $EXIT
fi

# =============================================================================
# Issue #3638 CA-F-11 — Ghost-artifact lint sobre archivos del pipeline.
#
# Bloquea commits que introduzcan readdirSync sobre carpetas operacionales
# (.pipeline/definicion/**, .pipeline/desarrollo/**) sin aplicar el filtro
# `isMarkerArtifact`. Defensa en profundidad complementada por el job CI
# `ghost-artifact-lint` (CA-SEC-8) que captura bypass con --no-verify.
#
# Solo corre cuando se tocan archivos bajo `.pipeline/`. Sin matches,
# no consume tiempo del flujo normal de commits.
# =============================================================================
RUN_GHOST_LINT=0
case "$TOUCHED_FILES" in
  *".pipeline/"*) RUN_GHOST_LINT=1 ;;
esac

if [ "$RUN_GHOST_LINT" = "1" ] && [ -f ".pipeline/lib/ghost-artifact-lint.js" ]; then
  node .pipeline/lib/ghost-artifact-lint.js --check
  LINT_EXIT=$?
  if [ "$LINT_EXIT" != "0" ]; then
    exit $LINT_EXIT
  fi
fi

exit 0
