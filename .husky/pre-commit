#!/usr/bin/env sh
# Gates de pre-commit independientes. Cada lint conserva su propio contrato.
#
# ORDEN Y ALCANZABILIDAD: ningún gate corta el hook con un `exit 0` propio.
# Antes, el `exit 0` de la validación de agent-models dejaba muerto todo lo que
# viniera después; ese early-exit se eliminó en #5244, así que cada bloque de
# acá abajo corre en TODO commit que le corresponda por su propio filtro.

TOUCHED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

# Secret scan (#5244 + #6111): guard compartido local/CI. Corre para todo
# commit, sin filtro de paths, antes de cualquier otro gate y exactamente una
# vez. Cubre las dos capas del scanner: paths sensibles del inventario
# (.pipeline/lib/sensitive-paths.js) y secretos en el contenido agregado.
if [ -f ".pipeline/lib/precommit-secret-scan.js" ]; then
  node .pipeline/lib/precommit-secret-scan.js --staged
  SCAN_EXIT=$?
  if [ "$SCAN_EXIT" != "0" ]; then
    exit "$SCAN_EXIT"
  fi
else
  printf '[warn] secret-scan skip: falta .pipeline/lib/precommit-secret-scan.js\n' >&2
fi

# =============================================================================
# Issue #5175 CA-4b — Guardrail del envoltorio de estado operativo
# (`.pipeline/lib/operational-state.js`), capa local del doble wiring.
#
# MODO `--check` (BLOQUEANTE) desde #5179 — el flip de la parte 3 del split.
#
# Historia de por que estuvo en `--report-only` hasta aca (R5 del issue): al
# momento del merge de la parte 1 el repo tenia 18 violations reales — la
# migracion de lectores fue la parte 2 (#5176) y la de escritores la parte 3
# (#5179). Con `--check` desde el principio, TODO commit que tocara `.pipeline/`
# habria fallado, el remedio obvio habria sido `--no-verify`, y eso mata la capa
# local del doble wiring de forma permanente.
#
# Con el inventario de produccion en CERO ese riesgo ya no existe: el hook solo
# bloquea cuando alguien AGREGA un acceso directo nuevo, que es exactamente lo
# que se quiere frenar. Ahora si propaga el exit code, como el bloque de
# ghost-artifact-lint.
#
# Se filtra a los archivos staged (`--only`): sin filtro escupe avisos de
# archivos que el dev no toco en cada commit que roce `.pipeline/`, y eso
# entrena a ignorar el hook (UX-1). Con el hook bloqueante el filtro ademas
# garantiza que nadie quede bloqueado por una violation que no introdujo.
# =============================================================================
if [ -f ".pipeline/lib/operational-state-lint.js" ]; then
  OPSTATE_ONLY=$(printf '%s\n' "$TOUCHED_FILES" | grep '^\.pipeline/.*\.js$' | paste -sd, - 2>/dev/null || true)
  if [ -n "$OPSTATE_ONLY" ]; then
    node .pipeline/lib/operational-state-lint.js --check --only="$OPSTATE_ONLY" || exit 1
  fi
fi

# =============================================================================
# Issue #6260 — Guardrail de contaminacion de `process.env` en tests.
#
# BLOQUEANTE DESDE EL DIA UNO (seccion 2 del issue), no `--report-only`: bajo el
# ratchet el hook solo frena VIOLATIONS NUEVAS. Las estrictas preexistentes estan
# congeladas en `test-env-lint.baseline.json` (shrink-only, deuda visible) y la
# deuda ordinaria en `test-env-lint.allowlist.json`. Con `--report-only` el gate
# no gatea; con el ratchet no hay que elegir entre bloquear y no romper a nadie.
#
# PERO OJO — el hook tambien frena por entries de allowlist OBSOLETAS (CA-21), y
# eso NO es "algo nuevo": la allowlist ancla `deuda` por (archivo, LINEA), asi que
# editar un test allowlisteado desplaza sus lineas y desactualiza sus entries.
# Es el caso normal, no el excepcional (~23% de los tests del pipeline tienen
# deuda anclada por linea). La salida NO es `--no-verify` — es regenerar:
#
#     node .pipeline/lib/test-env-lint.js --write-allowlist
#
# El writer solo aborta por archivos UNTRACKED en alcance (R-A2) o por una
# violation ESTRICTA presente (CA-24). Los TRACKED modificados/staged NO lo
# bloquean, que es lo que en rev-1 producia el deadlock (hook exige regenerar,
# writer exigia commitear, hook no deja commitear). El propio `--check` imprime
# este remedio cuando el rojo son entries obsoletas.
#
# ANCLA DE INSERCION: inmediatamente despues del `fi` que cierra el bloque de
# `operational-state-lint`. Se inserta por ancla TEXTUAL y no por numero de
# linea (R-A8: cualquier PR concurrente mueve el hueco).
#
# SIN `--only` (CA-25): el precedente de `operational-state-lint` NO se copia.
# Un scan filtrado rompe el piso de escaneo de CA-15'. El hook gatea por
# PRESENCIA de archivos `.pipeline/` staged (como `RUN_GHOST_LINT` mas abajo) y
# cuando decide correr escanea el universo completo.
# =============================================================================
RUN_TEST_ENV_LINT=0
case "$TOUCHED_FILES" in
  *".pipeline/"*) RUN_TEST_ENV_LINT=1 ;;
esac
if [ "$RUN_TEST_ENV_LINT" = "1" ] && [ -f ".pipeline/lib/test-env-lint.js" ]; then
  node .pipeline/lib/test-env-lint.js --check
  TEST_ENV_LINT_EXIT=$?
  if [ "$TEST_ENV_LINT_EXIT" != "0" ]; then
    exit "$TEST_ENV_LINT_EXIT"
  fi
fi

# Validación de agent-models (#3081): gate propio.
RUN_VALIDATE=0
case "$TOUCHED_FILES" in
  *".pipeline/agent-models.json"*) RUN_VALIDATE=1 ;;
esac
if [ "$RUN_VALIDATE" = "0" ]; then
  case "$TOUCHED_FILES" in
    *".pipeline/agent-models.schema.json"*|*".pipeline/lib/agent-models-validate.js"*)
      if [ -f ".pipeline/agent-models.json" ]; then RUN_VALIDATE=1; fi
      ;;
  esac
fi

if [ "$RUN_VALIDATE" = "1" ]; then
  # Bootstrapping defensivo: si node_modules/ajv no existe, NO bloquear el
  # commit. Cubre clones frescos y ramas que aún no corrieron `npm install`.
  if [ ! -d "node_modules/ajv" ]; then
    printf '[warn] agent-models validate skip: falta "ajv" (correr "npm install")\n' >&2
  else
    node .pipeline/lib/agent-models-validate.js --quiet
    VALIDATE_EXIT=$?
    # 3 = toolchain ausente en runtime → warning. 2 = config inválida → bloquea.
    if [ "$VALIDATE_EXIT" = "3" ]; then
      printf '[warn] agent-models validate skip: toolchain incompleto (correr "npm install")\n' >&2
    elif [ "$VALIDATE_EXIT" != "0" ]; then
      exit "$VALIDATE_EXIT"
    fi
  fi
fi

# =============================================================================
# Issue #3638 CA-F-11 — Ghost-artifact lint sobre archivos del pipeline.
#
# Bloquea commits que introduzcan readdirSync sobre carpetas operacionales
# (.pipeline/definicion/**, .pipeline/desarrollo/**) sin aplicar el filtro
# `isMarkerArtifact`. Defensa en profundidad complementada por el job CI
# `ghost-artifact-lint` (CA-SEC-8) que captura bypass con --no-verify.
#
# Gate propio, ahora siempre alcanzable (#5244 sacó el early-exit de arriba).
# =============================================================================
RUN_GHOST_LINT=0
case "$TOUCHED_FILES" in
  *".pipeline/"*) RUN_GHOST_LINT=1 ;;
esac
if [ "$RUN_GHOST_LINT" = "1" ] && [ -f ".pipeline/lib/ghost-artifact-lint.js" ]; then
  node .pipeline/lib/ghost-artifact-lint.js --check
  LINT_EXIT=$?
  if [ "$LINT_EXIT" != "0" ]; then exit "$LINT_EXIT"; fi
fi

exit 0
